# ====================
# FBA LogiAI 环境变量配置示例
# ====================
# 使用方法:
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 修改 .env 中的配置为你的真实值
#   3. 启动服务: docker-compose -f docker-compose-infra.yml --env-file .env up -d
#
# 注意: .env 文件包含敏感信息，请勿提交到版本控制系统

# ====================
# PostgreSQL 数据库
# ====================
POSTGRES_USER=fba_admin
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=fba_logi_db

# PostgreSQL 主从复制
REPLICATION_USER=replicator
REPLICATION_PASSWORD=your_replication_password_here

# ====================
# Redis 缓存
# ====================
REDIS_PASSWORD=your_redis_password_here

# ====================
# Nacos 配置中心
# ====================
# Nacos 认证 Token (至少64字符)
NACOS_AUTH_TOKEN=your_nacos_auth_token_at_least_64_characters_long_here_xxxxxxxx

# ====================
# RustFS / Milvus 对象存储
# ====================
RUSTFS_ACCESS_KEY=your_rustfs_access_key
RUSTFS_SECRET_KEY=your_rustfs_secret_key

# ====================
# Grafana 监控
# ====================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# ====================
# AI 服务 API Keys
# ====================
# DeepSeek API (用于智能对话)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 智谱 AI API (用于 Embedding 和 RAG)
ZHIPU_API_KEY=your-zhipu-api-key-here

# LLM 服务提供商 (deepseek 或 zhipu)
LLM_PROVIDER=deepseek
